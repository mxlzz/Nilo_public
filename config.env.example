# Nilo recuperará automáticamente este archivo desde una instalación anterior en el primer inicio, si la hay.
# Copiar como config.env solo para una instalación nueva.
# En una actualización no reemplazar config.env existente.
PROVIDER=gemini
MODEL=gemini-3.1-flash-lite
# Modelos de respaldo con la MISMA API de Gemini (en orden).
# Las cuotas son por modelo/proyecto; dejar vacío para desactivar.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_API_KEY=
BACKUP_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
MAX_LLM_CALLS_PER_DAY=100
MAX_CHAT_CALLS_PER_DAY=40
# Mínimo global entre deliberaciones exitosas; 10–300 s. Las cuotas 429 siguen vigentes.
MIN_REAL_SECONDS_BETWEEN_CALLS=15
PORT=8765
